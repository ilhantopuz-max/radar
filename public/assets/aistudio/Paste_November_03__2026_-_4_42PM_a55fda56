/////Moving Average/////
// Tillson T3
sm1(src, per1, f) =>
    t3e1 = ta.ema(src, per)
    t3e2 = ta.ema(t3e1, per)
    t3e3 = ta.ema(t3e2, per)
    t3e4 = ta.ema(t3e3, per)
    t3e5 = ta.ema(t3e4, per)
    t3e6 = ta.ema(t3e5, per)
    c1 = -f * f * f
    c2 = 3 * f * f + 3 * f * f * f
    c3 = -6 * f * f - 3 * f - 3 * f * f * f
    c4 = 1 + 3 * f + f * f * f + 3 * f * f
    s0 = c1 * t3e6 + c2 * t3e5 + c3 * t3e4 + c4 * t3e3
    s0

//Simple Moving Average - SMA
sm2(src, per) =>
    s1 = ta.sma(src, per)
    s1

//Exponential Moving Average - EMA
sm3(src, per) =>
    s2 = ta.ema(src, per)
    s2

//Double Exponential Moving Average - DEMA
sm4(src, per) =>
    s3 = 2 * ta.ema(src, per) - ta.ema(ta.ema(src, per), per)
    s3

//Triple Exponential Moving Average – TEMA
sm5(src, per) =>
    s4 = 3 * (ta.ema(src, per) - ta.ema(ta.ema(src, per), per)) + ta.ema(ta.ema(ta.ema(src, per), per), per)
    s4

//Weighted Moving Average - WMA
sm6(src, per) =>
    s5 = ta.wma(src, per)
    s5

//Volume Weighted Moving Average - VWMA
sm7(src, per) =>
    s6 = ta.vwma(src, per)
    s6

//Smoothed Moving Average - SMMA
sm8(src, per) =>
    s7 = 0.0
    sma_1 = ta.sma(src, per)
    s7 := na(s7[1]) ? sma_1 : (s7[1] * (per - 1) + src) / per
    s7

// Hull Moving Average - HMA
sm9(src, per) =>
    s8 = ta.wma(2 * ta.wma(src, per / 2) - ta.wma(src, per), math.round(math.sqrt(per)))
    s8

//Exponential Hull Moving Average - EHMA
sm10(src, per) =>
    s8 = ta.ema(2 * ta.ema(src, per / 2) - ta.ema(src, per), math.round(math.sqrt(per)))
    s8

//Least Squares Moving Average - LSMA
sm11(src, per, offsig) =>
    s9 = ta.linreg(src, per, offsig)
    s9

//Arnaud Legoux Moving Average - ALMA
sm12(src, per, offalma, offsig) =>
    s10 = ta.alma(src, per, offalma, offsig)
    s10

//Triangular Moving Average - TMA
sm13(src, per) =>
    s11 = ta.sma(ta.sma(src, per), per)
    s11

// SuperSmoother filter
sm14(src, per) =>
    a1 = math.exp(-1.414 * 3.14159 / per)
    b1 = 2 * a1 * math.cos(1.414 * 3.14159 / per)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1 - c2 - c3
    s12 = 0.0
    s12 := c1 * (src + nz(src[1])) / 2 + c2 * nz(s12[1]) + c3 * nz(s12[2])
    s12

//Elastic Volume Weighted Moving Average - EVWMA
sm15(src, per) =>
    hacimtoplam = math.sum(volume, per)
    s13 = 0.0
    s13 := nz(s13[1]) * (hacimtoplam - volume) / hacimtoplam + volume * src / hacimtoplam
    s13

//Variable Moving Average - VAR 
sm16(src, per) =>
    valpha = 2 / (per + 1)
    vud1 = src > src[1] ? src - src[1] : 0
    vdd1 = src < src[1] ? src[1] - src : 0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    s14 = 0.0
    s14 := nz(valpha * math.abs(vCMO) * src) + (1 - valpha * math.abs(vCMO)) * nz(s14[1])
    s14

//Kaufman Moving Average Adaptive (KAMA)
sm17(src, per) =>
    xvnoise = math.abs(src - src[1])
    nfastend = 0.666
    nslowend = 0.0645
    nsignal = math.abs(src - src[per])
    nnoise = math.sum(xvnoise, per)
    nefratio = nnoise != 0 ? nsignal / nnoise : 0
    nsmooth = math.pow(nefratio * (nfastend - nslowend) + nslowend, 2)
    s15 = 0.0
    s15 := nz(s15[1]) + nsmooth * (src - nz(s15[1]))
    s15

